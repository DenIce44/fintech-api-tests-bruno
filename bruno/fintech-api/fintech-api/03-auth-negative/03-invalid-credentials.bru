meta {
  name: 03-invalid-credentials
  type: http
  seq: 3
  tags: [
    regression
    auth-negative
  ]
}

post {
  url: {{authBaseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{authUsername}}",
    "password": "{{invalidAuthPassword}}",
    "expiresInMins": 30
  }
}

vars:pre-request {
  invalidAuthPassword: wrong-demo-password
}

assert {
  @description('DummyJSON отклоняет неверные credentials')
  res.status: eq 400
  @description("'ошибка возвращена в JSON'")
  res.headers['content-type']: contains application/json
  @description("'сообщение ошибки присутствует'")
  res.body.message: isString
}

tests {
  test("invalid password does not create a session", function () {
    const body = res.getBody();
  
    expect(res.getStatus()).to.eql(400);
    expect(body).to.be.an("object");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body).to.not.have.property("accessToken");
    expect(body).to.not.have.property("refreshToken");
  });
  
  test("error response does not echo the submitted password", function () {
    const serializedBody = JSON.stringify(res.getBody());
    const submittedPassword = bru.getRequestVar("invalidAuthPassword");
  
    expect(serializedBody).to.not.include(submittedPassword);
    expect(serializedBody).to.not.include("accessToken");
    expect(serializedBody).to.not.include("refreshToken");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
